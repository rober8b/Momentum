# ── App ──────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Postgres (Railway) ───────────────
# Conn string del Postgres provisioneado en Railway.
# Settings → Variables → DATABASE_URL (formato postgres://user:pass@host:port/db)
DATABASE_URL=

# ── Auth (password + cookie firmada) ─
# Password con la que entrás a la app. Cambialo cuando quieras editando este valor.
APP_PASSWORD=

# Secret para firmar las cookies de sesión (mínimo 16 chars, idealmente 32+).
# Generar con: openssl rand -hex 32
SESSION_SECRET=

# ── Vault export (opcional) ──────────
# Si más adelante automatizamos push directo a un repo de GitHub.
VAULT_REPO_OWNER=
VAULT_REPO_NAME=
GITHUB_TOKEN=

# ── Cron secret (Vercel cron auth) ───
# Header Authorization: Bearer ${CRON_SECRET} para que el cron de Vercel
# pueda golpear /api/export sin sesión.
CRON_SECRET=

# ── Email (Resend) ────────────────────
# Sin estas vars, la app entra en log-mode: los links se imprimen en consola.
# Para enviar emails reales en producción:
#   1. Crear cuenta en resend.com
#   2. Verificar tu dominio (resend.com te da los DNS records)
#   3. Setear RESEND_API_KEY y EMAIL_FROM
RESEND_API_KEY=
# Debe ser una dirección de un dominio verificado en tu cuenta de Resend.
# ⚠️  No uses dominios ajenos — usá el tuyo propio.
EMAIL_FROM=

# ── Registro de nuevos usuarios ──────
# ALLOW_SIGNUP=true   → habilita la página /signup (deshabilitada por defecto)
# REQUIRE_EMAIL_CONFIRMATION=true → el usuario debe confirmar su email antes de entrar
#   Requiere RESEND_API_KEY + EMAIL_FROM seteados, sino la app falla al arrancar.
ALLOW_SIGNUP=
REQUIRE_EMAIL_CONFIRMATION=
