# ── App ──────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Postgres (Railway) ───────────────
# Conn string del Postgres provisioneado en Railway.
# Settings → Variables → DATABASE_URL (formato postgres://user:pass@host:port/db)
DATABASE_URL=

# ── Auth (password + cookie firmada) ─
# Password con la que entrás a la app. Cambialo cuando quieras editando este valor.
APP_PASSWORD=

# Secret para firmar las cookies de sesión (mínimo 16 chars, idealmente 32+).
# Generar con: openssl rand -hex 32
SESSION_SECRET=

# ── Vault export (opcional) ──────────
# Si más adelante automatizamos push directo a un repo de GitHub.
VAULT_REPO_OWNER=
VAULT_REPO_NAME=
GITHUB_TOKEN=

# ── Cron secret (Vercel cron auth) ───
# Header Authorization: Bearer ${CRON_SECRET} para que el cron de Vercel
# pueda golpear /api/export sin sesión.
CRON_SECRET=
