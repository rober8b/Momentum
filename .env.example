# ─────────────────────────────────────────────────────────────────────────────
# command-center — environment variables
#
# Copy this file to .env.local and fill in the values before running the app.
#   cp .env.example .env.local
#
# [required] — app will not start without this value
# [optional] — app runs without it with reduced functionality
# ─────────────────────────────────────────────────────────────────────────────


# ── DATABASE ──────────────────────────────────────────────────────────────────

# [required] PostgreSQL connection string.
# Format: postgres://USER:PASSWORD@HOST:PORT/DATABASE
# Recommended: provision a free Postgres on Railway (railway.app) and copy
# the connection string from Settings → Variables → DATABASE_URL.
DATABASE_URL=postgres://user:password@host:5432/command_center


# ── AUTH ──────────────────────────────────────────────────────────────────────

# [required] Secret used to HMAC-sign session cookies.
# Minimum 32 characters. Use a cryptographically random hex string:
#   Bash / WSL:  openssl rand -hex 32
#   PowerShell:  -join ((0..63) | %{ '{0:x}' -f (Get-Random -Max 16) })
# Rotating this value invalidates all existing sessions (forced logout for all users).
SESSION_SECRET=change-me-to-a-random-32-char-hex-string-before-deploying


# ── APP URL ───────────────────────────────────────────────────────────────────

# [optional] Base URL of the deployment. Used to build absolute links in emails
# (password reset, email confirmation). Defaults to http://localhost:3000.
# In production, set to your Vercel URL or custom domain — no trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# ── USER REGISTRATION ─────────────────────────────────────────────────────────

# [optional] Enable the /signup page so new users can create accounts.
# Default: false — only the first-run setup wizard at /setup is available.
# Set to "true" if you want to allow others to self-register.
ALLOW_SIGNUP=false

# [optional] Require new users to verify their email before logging in.
# Default: false.
# When "true", RESEND_API_KEY and EMAIL_FROM become required — the app will
# throw at startup if they are missing.
REQUIRE_EMAIL_CONFIRMATION=false


# ── EMAIL (Resend) ────────────────────────────────────────────────────────────
#
# The app uses Resend (resend.com) for transactional emails:
#   • Password reset links  (/forgot-password)
#   • Email confirmation on signup  (when REQUIRE_EMAIL_CONFIRMATION=true)
#
# Without these vars the app runs in log-mode: email content and the one-time
# links are printed to the server console instead of being sent. This is the
# default for local development — no Resend account needed.
#
# To enable real email sending:
#   1. Create a free account at resend.com
#   2. Add and verify a domain you own (Resend provides DNS records to add)
#   3. Create an API key, copy it below, and set EMAIL_FROM

# [optional / required when REQUIRE_EMAIL_CONFIRMATION=true]
# Your Resend API key — starts with "re_".
RESEND_API_KEY=re_your_resend_api_key_here

# [optional / required when REQUIRE_EMAIL_CONFIRMATION=true]
# The From address for outgoing emails. Must be on a domain verified in Resend.
# ⚠️  Use your own verified domain — never use someone else's.
EMAIL_FROM=noreply@yourdomain.com


# ── CRON / VAULT EXPORT ───────────────────────────────────────────────────────

# [optional] Bearer token that Vercel sends when triggering the weekly export
# cron job (schedule configured in vercel.json). The /api/export handler
# validates this header. Without it the route is unprotected — set it in prod.
# Generate: openssl rand -hex 24
CRON_SECRET=your-cron-secret-here


# ── GITHUB INTEGRATION ────────────────────────────────────────────────────────

# [optional] Personal access token used to show the last-push date on repos
# linked to freelance clients and own projects. Without this the last-push
# field is left empty instead of showing a real timestamp.
# Required scopes: public_repo (for public repos) or repo (for private repos).
GITHUB_TOKEN=ghp_your_github_token_here
