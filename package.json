{
  "name": "momentum",
  "version": "0.1.0",
  "description": "The organization platform for builders",
  "author": "Robertino Barbuto",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rober8b/Momentum"
  },
  "keywords": [
    "dashboard",
    "personal",
    "self-hosted",
    "productivity",
    "obsidian",
    "nextjs"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "npm run db:migrate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:seed:demo": "npx tsx --env-file=.env.local scripts/seed-demo.ts",
    "db:seed:minimal": "npx tsx --env-file=.env.local scripts/seed-minimal.ts",
    "db:reset": "npx tsx --env-file=.env.local scripts/db-reset.ts",
    "db:migrate": "npx tsx scripts/db-migrate.ts",
    "db:migrate:local": "npx tsx --env-file=.env.local scripts/db-migrate.ts",
    "db:baseline": "npx tsx scripts/db-baseline.ts",
    "db:baseline:local": "npx tsx --env-file=.env.local scripts/db-baseline.ts",
    "db:up": "docker compose -f docker-compose.dev.yml up -d",
    "db:down": "docker compose -f docker-compose.dev.yml down",
    "db:down:volume": "docker compose -f docker-compose.dev.yml down -v"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@polar-sh/sdk": "^0.48.1",
    "@types/bcryptjs": "^2.4.6",
    "@vercel/analytics": "^2.0.1",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.16.0",
    "motion": "^12.40.0",
    "next": "16.2.6",
    "postgres": "^3.4.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.12.4",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.9"
  }
}
